{
  "name": "thelounge-plugin-catchup",
  "version": "0.1.0",
  "description": "Summarizes what you missed in IRC channels on The Lounge, on demand and only in your own client, using the LLM you configure.",
  "main": "index.js",
  "license": "MIT",
  "private": false,
  "author": "Kamil Jiwa",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kjiwa/thelounge-plugin-catchup.git"
  },
  "homepage": "https://github.com/kjiwa/thelounge-plugin-catchup#readme",
  "bugs": "https://github.com/kjiwa/thelounge-plugin-catchup/issues",
  "keywords": [
    "thelounge-plugin",
    "thelounge",
    "irc",
    "summarize",
    "llm"
  ],
  "files": [
    "index.js",
    "lib/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.17"
  },
  "thelounge": {
    "supports": "^4.5.2"
  },
  "scripts": {
    "test": "node --test \"test/unit/*.test.js\"",
    "test:e2e": "node --test --test-timeout=120000 \"test/e2e/*.test.js\"",
    "lint": "eslint .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "socket.io-client": "4.8.4",
    "thelounge": "4.5.2"
  },
  "dependencies": {
    "@ai-sdk/amazon-bedrock": "5.0.106",
    "@ai-sdk/anthropic": "4.0.72",
    "@aws-sdk/client-lambda": "3.1146.0",
    "@aws-sdk/credential-providers": "3.1146.0",
    "ai": "7.0.128"
  }
}
